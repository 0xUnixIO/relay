[Unit]
Description=Apply pending relay-master upgrade
Documentation=https://github.com/unix-relay/relay
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/relay-master/upgrade-request.json

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/lib/relay-master/relay-master-updater
TimeoutStartSec=600
# 超时被 kill 时也删除请求文件，避免 path unit 无限重触
ExecStopPost=-/bin/rm -f /var/lib/relay-master/upgrade-request.json
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
